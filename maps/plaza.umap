# unionized_mech map: the plaza. Edit while the game runs and it reloads live.
# spawn x y z yaw | box x0 y0 z0 x1 y1 z1 (visible) | cbox ... (collision only)

spawn 0 0 38 0

# Central plaza blocks
box -15 0 -15 -13 2 -13
box 12 0 -16 16 4 -12
box -17 0 11 -11 6 17
box 10 0 10 18 8 18
box -1 0 -19 1 2 -17
box -2 0 16 2 4 20
box -21 0 -3 -15 6 3
box 14 0 -4 22 8 4
box -7 0 5 -5 2 7
box 6 0 -6 10 4 -2

# Wallrun gauntlet, east: zig-zag between parallel offset walls
box 18 0 30 26 6 31.5
box 28 0 24 36 6 25.5
box 38 0 30 44 6 31.5

# Mantle stairs, south: each step one vault higher
box -30 0 -38 -26 1 -34
box -25 0 -38 -21 2 -34
box -20 0 -38 -16 3 -34
box -15 0 -38 -11 4 -34

# Tower, north-west: long wallruns ending in a mantle
box -40 0 28 -32 10 36

# Practice wall, west
box -44 0 -12 -42 7 12

# Wallrun highway, west. Two faces 4m apart running north-south. A wallrun
# holds 10.7 m/s against a 6.6 m/s sprint, so taking the corridor properly beats
# running the open ground, and it is 20m long against a 1.75s wallrun limit, so
# it cannot be done on one wall: jump the gap halfway and finish on the other.
box -36 0 12 -34 8 32
box -30 0 12 -28 8 32

# Step run, east. 0.4m risers, under the 0.457m step height, so this is walked
# up at full speed rather than vaulted. Kerbs should never cost you momentum.
box 32 0 6 38 0.4 10
box 32 0 10 38 0.8 14
box 32 0 14 38 1.2 18
box 32 0 18 38 1.6 22

# Slide gates. 1.1m of clearance: taller than the 1.0m crouched hull, shorter
# than the 1.8m standing one. The only way through is fast and crouched, which
# gives sliding a job on flat ground that speed alone cannot do.
box -8 1.1 22 8 3.2 24
box 18 1.1 -8 32 3.2 -6

# Wall kick shaft, south-east. Faces 4m apart, inside the 4.1m a wall jump
# carries. Each kick tops out 1.14m above the last, so the perch is a climb.
box 30 0 -34 38 6 -32.5
box 30 0 -28.5 38 6 -27
box 30 6 -34 38 7 -27

# Perimeter: nobody leaves the arena, and the walls are tall enough to run on
cbox -45 0 -45 45 25 -44
cbox -45 0 44 45 25 45
cbox -45 0 -45 -44 25 45
cbox 44 0 -45 45 25 45

# Bot waypoints, auto-linked to reachable neighbours on load
node 0 0 38
node 14 0 34
node -14 0 30
node 8 0 22
node -26 0 22
node 26 0 20
node -38 0 8
node -28 0 6
node 0 0 8
node 30 0 4
node -8 0 -8
node 8 0 -10
node 34 0 -10
node -28 0 -12
node 30 0 -22
node -12 0 -24
node -24 0 -28
node 0 0 -28
node 12 0 -30
node -13 4 -36
node 0 0 -41

# Routes through the new geometry, so bots use them too rather than walking
# around the outside of everything.
node -32 0 16
node -32 0 26
node 35 0 4
node 30 0 14
node 34 0 -24
